@startuml
title Déconnexion de l'utilisateur (Frontend)
autonumber

actor "Utilisateur" as User
participant "UI" as UI
participant "Backend" as BE

User -> UI : Clique sur le bouton "Sign out"
UI -> BE : DELETE /api/session
BE --> UI : 204 + cookie "session" effacé
UI --> User : redirige /login

@enduml
