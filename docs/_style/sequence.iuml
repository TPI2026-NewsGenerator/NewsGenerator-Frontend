' Style shared by the sequence diagrams of the client (client-2*.puml). A participant is a React
' component, a hook or an ES module of src/: its messages are the functions called and the props
' given, in the order of the code. The server is one participant, its routes on the messages.
skinparam shadowing false
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #C9B458
skinparam sequence {
    ParticipantBackgroundColor #FFFFFF
    ParticipantBorderColor #555555
    DatabaseBackgroundColor #F2F2F2
    DatabaseBorderColor #888888
    LifeLineBorderColor #999999
    ArrowColor #555555
    GroupBorderColor #7A93B8
    GroupBackgroundColor #EEF3FA
    BoxBorderColor #CCCCCC
}
autonumber
hide footbox
