@startuml
title Suppression de recherche personnalisée (Frontend)
autonumber

actor "Utilisateur" as User
participant "SearchPage" as UI
participant "Backend" as BE
database "Base de données" as DB

User -> UI : Clique sur "Delete" à côté de la recherche
UI -> BE : DELETE /api/customsearch {id}
BE -> DB : deleteUserCustomSearch(id, userId)
alt supprimée
    DB --> BE : ok
    BE --> UI : {deleted: true}
    UI -> UI : retirée de la liste locale
    UI --> User : toast "deleted successfully !"
else pas une recherche de cet utilisateur (404) ou erreur
    BE --> UI : {error}
    UI -> BE : GET /api/customsearch
    BE --> UI : la liste telle que le serveur l'a
    UI --> User : toast "Error deleting ..."
end

@enduml
